# make demo creates a private .env automatically. Never commit actual credentials.
COMPOSE_PROJECT_NAME=pawline_demo
WEB_PORT=3000
MAIL_PORT=8025
DATABASE_UI_PORT=5555
APP_PUBLIC_ORIGIN=http://127.0.0.1:3000
POSTGRES_USER=pawline
POSTGRES_PASSWORD=GENERATE_LOCALLY
POSTGRES_DB=pawline
STAFF_PASSWORD=GENERATE_LOCALLY
MAIL_PASSWORD=GENERATE_LOCALLY
SESSION_SECRET=GENERATE_LOCALLY
MEDIA_DIR=/media
SMTP_HOST=mailpit
SMTP_PORT=1025
MAILPIT_URL=http://mailpit:8025
